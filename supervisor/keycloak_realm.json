{
  "realm": "reckon",
  "enabled": true,
  "displayName": "reckon",
  "registrationAllowed": false,
  "rememberMe": true,
  "verifyEmail": false,
  "loginTheme": "keycloak",
  "accessTokenLifespan": 3600,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 28800,
  "sslRequired": "external",
  "roles": {
    "realm": [
      {"name": "viewer", "description": "Read-only access to investigations"},
      {"name": "analyst", "description": "Can create and modify investigations"},
      {"name": "approver", "description": "Can approve actions at trust tier T2"},
      {"name": "senior_approver", "description": "Can approve actions at trust tier T3"},
      {"name": "policy_author", "description": "Can author CEL policies"},
      {"name": "policy_signer", "description": "Can sign policies in gated governance mode"},
      {"name": "sop_author", "description": "Can author SOPs"},
      {"name": "sop_signer", "description": "Can sign SOPs in gated governance mode"},
      {"name": "tenant_admin", "description": "Tenant-level administration"},
      {"name": "auditor", "description": "Read-only audit access"}
    ]
  },
  "clients": [
    {
      "clientId": "reckon",
      "name": "reckon CLI / VS Code extension (human principal)",
      "description": "Tokens from this client carry NO delegate_kind: a request authenticated here is a human acting directly.",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["http://localhost:*", "vscode://*"],
      "webOrigins": ["+"],
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "reckon-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "reckon",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "reckon-agent",
      "name": "reckon agent loop (AI delegate)",
      "description": "The surface obtains tokens here for AI-driven turns. A hardcoded-claim mapper stamps delegate_kind=claude issuer-side (never caller-supplied), while sub stays the analyst and the realm roles carry — so AI is a delegate on the human's behalf, never a principal. The engine derives Actor.Kind from this claim; the AI-write-protection allowlist and Gate 2 baseline DENY key off it. A human token (reckon client) can never gain this claim, and an agent token can never shed it.",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["http://localhost:*", "vscode://*"],
      "webOrigins": ["+"],
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "reckon-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "reckon",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        },
        {
          "name": "reckon-delegate-kind",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "delegate_kind",
            "claim.value": "claude",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "reckon-admin",
      "enabled": true,
      "emailVerified": true,
      "firstName": "reckon",
      "lastName": "Admin",
      "credentials": [
        {"type": "password", "value": "reckon", "temporary": true}
      ],
      "realmRoles": ["tenant_admin", "analyst", "approver", "senior_approver"]
    }
  ]
}
