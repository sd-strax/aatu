{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Workbench Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        // --disable-extensions keeps the dev host clean: only reckon loads, so
        // Output/behavior is the extension as an analyst gets it, not your
        // personal extension set reacting to this folder.
        "--disable-extensions",
        "--extensionDevelopmentPath=${workspaceFolder}"
      ],
      "outFiles": ["${workspaceFolder}/out/**/*.js"],
      "preLaunchTask": "npm: compile"
    },
    {
      "name": "Run Workbench Extension (with your extensions)",
      "type": "extensionHost",
      "request": "launch",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}"],
      "outFiles": ["${workspaceFolder}/out/**/*.js"],
      "preLaunchTask": "npm: compile"
    }
  ]
}
